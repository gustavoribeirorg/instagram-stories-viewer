# ===== Configurações do Servidor =====
HOST=0.0.0.0
PORT=8000
DATA_DIR=data
DOWNLOAD_DIR=downloads
INTERVAL_HOURS=24
REQUEST_DELAY_SECONDS=3.0

# ===== Credenciais do Instagram (opcionais) =====
# IG_SESSIONID é usado pelo provedor direto para acesso mais estável.
# Deixe vazio para usar apenas os mirrors públicos.
IG_USERNAME=
IG_PASSWORD=
IG_SESSIONID=

# ===== Terceiro Mirror Configurável (Opção B) =====
# Endpoint e referer do mirror alternativo.
# Padrão: storysaver.net (ajuste conforme necessário).
MIRROR_API_URL=https://www.storysaver.net/api/ig/story
MIRROR_REFERER=https://www.storysaver.net/
